flowchart TB
  N["NORMALIZACIÓN: reducir redundancia y anomalías mediante descomposición sin pérdida"]
  N --> C["CONCEPTOS Y DEPENDENCIAS"]
  N --> F["FORMAS NORMALES: progresión de criterios"]
  N --> E["ANOMALÍAS Y APLICACIÓN"]
  C --> DF["Dependencia funcional X → Y: igual X implica igual Y"]
  DF --> CO["Completa: Y depende de todo X, no de un subconjunto"]
  DF --> PA["Parcial: parte de una clave compuesta determina atributo no primo"]
  DF --> TR["Transitiva: clave → departamento → nombre_departamento"]
  C --> DM["Dependencia multivaluada X ↠ Y: conjuntos independientes"]
  C --> DJ["Dependencia de reunión: reconstrucción mediante JOIN"]
  F --> F1["1FN: valores atómicos; separar teléfonos múltiples"]
  F1 --> F2["2FN: 1FN + sin dependencia parcial de atributos no primos"]
  F2 --> F3["3FN: X superclave o atributo determinado primo en cada DF no trivial"]
  F3 --> FB["FNBC: todo determinante de DF no trivial es superclave"]
  FB --> F4["4FN: toda DM no trivial tiene determinante superclave"]
  F4 --> F5["5FN: dependencias de reunión implicadas por claves candidatas"]
  E --> I["Inserción: no se puede registrar departamento sin empleado"]
  E --> B["Borrado: se pierde departamento al borrar último empleado"]
  E --> M["Modificación: mismo dato repetido puede quedar inconsistente"]
  E --> EX["Biblioteca: USUARIO / TELEFONO_USUARIO; RECURSO / PALABRA_CLAVE_RECURSO; AUTORIA"]
