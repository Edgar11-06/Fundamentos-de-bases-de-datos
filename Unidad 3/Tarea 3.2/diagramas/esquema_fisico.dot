digraph G {
graph [rankdir=LR, splines=polyline, nodesep=.35, ranksep=.75, bgcolor=white];
node [shape=record,style=filled,fillcolor="#eef5ff",color="#5b7595",fontsize=9,fontname="Helvetica"];
edge [color="#718096",arrowsize=.65,fontsize=8];
categoria [label="{CATEGORIA|id_categoria : VARCHAR(20) PK|nombre : VARCHAR(120) |descripcion : VARCHAR(MAX) }"];
usuario [label="{USUARIO|id_usuario : VARCHAR(20) PK|nombre_pila : VARCHAR(80) |apellido_paterno : VARCHAR(80) |apellido_materno : VARCHAR(80) |correo : VARCHAR(160) |fecha_registro : DATE |estatus : VARCHAR(20) }"];
estudiante [label="{ESTUDIANTE|id_usuario : VARCHAR(20) PK/FK|matricula : VARCHAR(30) |carrera : VARCHAR(120) |semestre : SMALLINT }"];
docente [label="{DOCENTE|id_usuario : VARCHAR(20) PK/FK|num_empleado : VARCHAR(30) |departamento : VARCHAR(120) }"];
externo [label="{EXTERNO|id_usuario : VARCHAR(20) PK/FK|institucion_origen : VARCHAR(160) |identificacion : VARCHAR(50) }"];
telefono_usuario [label="{TELEFONO_USUARIO|id_usuario : VARCHAR(20) PK/FK|telefono : VARCHAR(25) PK}"];
recurso [label="{RECURSO|id_recurso : VARCHAR(20) PK|titulo : VARCHAR(200) |anio_publicacion : SMALLINT |editorial : VARCHAR(120) |idioma : VARCHAR(60) |id_categoria : VARCHAR(20) FK}"];
libro [label="{LIBRO|id_recurso : VARCHAR(20) PK/FK|isbn : VARCHAR(20) |edicion : VARCHAR(40) }"];
revista [label="{REVISTA|id_recurso : VARCHAR(20) PK/FK|issn : VARCHAR(20) |volumen : VARCHAR(30) |numero : VARCHAR(30) }"];
tesis [label="{TESIS|id_recurso : VARCHAR(20) PK/FK|asesor : VARCHAR(160) |grado_academico : VARCHAR(100) }"];
palabra_clave_recurso [label="{PALABRA_CLAVE_RECURSO|id_recurso : VARCHAR(20) PK/FK|palabra_clave : VARCHAR(80) PK}"];
autor [label="{AUTOR|id_autor : VARCHAR(20) PK|nombre : VARCHAR(160) |nacionalidad : VARCHAR(80) }"];
autoria [label="{AUTORIA|id_recurso : VARCHAR(20) PK/FK|id_autor : VARCHAR(20) PK/FK|orden_autoria : SMALLINT }"];
ejemplar [label="{EJEMPLAR|id_recurso : VARCHAR(20) PK/FK|num_ejemplar : INT PK|estado : VARCHAR(25) |ubicacion : VARCHAR(100) |fecha_adquisicion : DATE }"];
bibliotecario [label="{BIBLIOTECARIO|id_empleado : VARCHAR(20) PK|nombre : VARCHAR(160) |turno : VARCHAR(40) }"];
prestamo [label="{PRESTAMO|folio : VARCHAR(30) PK|id_usuario : VARCHAR(20) FK|id_recurso : VARCHAR(20) FK|num_ejemplar : INT FK|id_empleado : VARCHAR(20) FK|fecha_prestamo : DATE |fecha_limite : DATE |fecha_devolucion : DATE }"];
multa [label="{MULTA|id_multa : VARCHAR(20) PK|folio : VARCHAR(30) FK|tipo : VARCHAR(30) |monto : NUMERIC(10,2) |fecha_generacion : DATE |estatus_pago : VARCHAR(25) }"];
usuario -> estudiante;
usuario -> docente;
usuario -> externo;
usuario -> telefono_usuario;
categoria -> recurso;
recurso -> libro;
recurso -> revista;
recurso -> tesis;
recurso -> palabra_clave_recurso;
recurso -> autoria;
autor -> autoria;
recurso -> ejemplar;
usuario -> prestamo;
bibliotecario -> prestamo;
ejemplar -> prestamo;
prestamo -> multa;
}